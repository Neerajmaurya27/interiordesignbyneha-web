---
/**
 * /privacy — plain-language privacy notice (brief §5). Generated only once
 * src/content/pages/privacy.md is published, after counsel review [V26].
 */
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DevBadge from '../../components/ui/DevBadge.astro';
import { site } from '../../data/site';
import { getPage } from '../../lib/pages';

export async function getStaticPaths() {
  return (await getPage('privacy')) ? [{ params: { index: undefined } }] : [];
}

const page = (await getPage('privacy'))!;
const { Content } = await render(page.value);
const { title, description, intro } = page.value.data;
---

<BaseLayout title={`${title} | ${site.name}`} {description} pageName={title} enquiryBar={false}>
  <div class="grid-page gap-y-10 pt-16 pb-(--spacing-section) desktop:pt-24">
    <header class="col-span-full flex flex-col gap-4 desktop:col-span-8">
      <h1>
        {title}
        {page.isFixture && <DevBadge label="Draft · not reviewed" />}
      </h1>
      {intro && <p class="type-statement">{intro}</p>}
    </header>
    <div class="prose col-span-full desktop:col-span-7">
      <Content />
    </div>
  </div>
</BaseLayout>
