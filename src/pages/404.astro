---
import BaseLayout from '../layouts/BaseLayout.astro';
import ChapterLabel from '../components/ui/ChapterLabel.astro';
import Button from '../components/ui/Button.astro';
import TextLink from '../components/ui/TextLink.astro';
import { enquiryCta, site } from '../data/site';
import { routeExists } from '../lib/routes';

const hasProjects = routeExists('/projects');
const hasEnquire = routeExists(enquiryCta.href);
const hasHome = routeExists('/');
---

<BaseLayout
  title={`Page not found | ${site.name}`}
  description="The page you were looking for is not here."
  pageName="Page not found"
  noindex
>
  <div class="grid-page py-(--spacing-section)">
    <div class="col-span-full flex flex-col gap-6 desktop:col-span-7">
      <ChapterLabel>Page not found</ChapterLabel>
      <h1>This page isn’t here</h1>
      <p>The link may be out of date, or the page may have moved.</p>
      {(hasProjects || hasEnquire) && (
        <div class="flex flex-wrap gap-4 pt-4">
          {hasProjects && (
            <Button href="/projects" variant="secondary">
              See our projects
            </Button>
          )}
          {hasEnquire && <Button href={enquiryCta.href}>{enquiryCta.label}</Button>}
        </div>
      )}
      {hasHome && (
        <p>
          Or return to the <TextLink href="/">home page</TextLink>.
        </p>
      )}
    </div>
  </div>
</BaseLayout>
