# Copy to .env for local development (and .dev.vars for `astro preview` in the Workers runtime).
# Never commit real values. In production, set public values as build variables and secrets with
# `wrangler secret put <NAME>`. The [V…] codes refer to docs/implementation-plan.md §7.

# Production domain, e.g. https://interiordesignbyneha.com  [V18]
SITE_URL=

# ── Enquiry form (Phase 7) ────────────────────────────────────────────────
# Build-time switch: the site links to /enquire only when true, and /enquire answers 404 until the
# services below are configured. [V25]
PUBLIC_ENQUIRY_ENABLED=false

# Cloudflare Turnstile. Test keys that always pass: site 1x00000000000000000000AA,
# secret 1x0000000000000000000000000000000AA.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend (transactional email). The from-address must be on a verified studio domain.
RESEND_API_KEY=
ENQUIRY_TO_EMAIL=
ENQUIRY_FROM_EMAIL=

# Where leads are recorded: sheets | crm | none
LEAD_STORE=none
# Google Sheets via a service account (share the sheet with the service-account email; the sheet
# needs a tab named "Leads"). Paste the private key with \n for line breaks.
GOOGLE_SHEETS_ID=
GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
# Or a CRM inbound webhook that accepts JSON.
CRM_WEBHOOK_URL=

# Must match the version printed in the published privacy notice. [V26]
PRIVACY_NOTICE_VERSION=draft

# Development only: skip Turnstile and providers and log enquiries to the console.
# A name containing "Simulate failure" exercises the error path. Ignored in production builds.
ENQUIRY_MOCK=false
