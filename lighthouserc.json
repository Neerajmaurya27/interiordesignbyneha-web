{
  "ci": {
    "collect": {
      "startServerCommand": "node scripts/serve-static.mjs 4323",
      "startServerReadyPattern": "Serving dist/client",
      "url": [
        "http://localhost:4323/",
        "http://localhost:4323/projects",
        "http://localhost:4323/projects/fixture-a",
        "http://localhost:4323/studio"
      ],
      "numberOfRuns": 3,
      "settings": {
        "formFactor": "mobile",
        "screenEmulation": { "mobile": true, "width": 390, "height": 844, "deviceScaleFactor": 3 },
        "chromeFlags": "--no-sandbox --headless=new",
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo"],
        "skipAudits": ["is-crawlable"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["warn", { "minScore": 0.9 }],
        "largest-contentful-paint": ["error", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["error", { "maxNumericValue": 200 }],
        "resource-summary:script:size": ["error", { "maxNumericValue": 30720 }],
        "resource-summary:stylesheet:size": ["error", { "maxNumericValue": 40960 }],
        "resource-summary:font:count": ["error", { "maxNumericValue": 5 }]
      }
    },
    "upload": { "target": "filesystem", "outputDir": ".lighthouseci/reports" }
  }
}
