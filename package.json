{
  "name": "interiordesignbyneha-web",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/clean-wrangler-redirect.mjs && astro dev",
    "build": "astro build && node scripts/check-placeholders.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "verify": "pnpm check && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "test:e2e": "playwright test",
    "launch:check": "node scripts/check-launch.mjs",
    "assets": "node scripts/asset-inventory.mjs"
  },
  "dependencies": {
    "@astrojs/cloudflare": "14.3.4",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@tailwindcss/vite": "4.3.3",
    "astro": "7.3.8",
    "jose": "6",
    "sharp": "^0.35.5",
    "tailwindcss": "4.3.3",
    "yaml": "2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.56.1",
    "@types/node": "22",
    "eslint": "^10.12.0",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.4",
    "wrangler": "~4.151.0"
  }
}
